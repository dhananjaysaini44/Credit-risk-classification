# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data (Never commit large raw data or sensitive user data to GitHub)
apps/ml-backend/data/

# Model Assets (Managed tracking via whitelist)
apps/ml-backend/assets_1/**
apps/ml-backend/assets_2/**

# Un-ignore directories so Git can traverse them to find whitelisted files
!apps/ml-backend/assets_1/**/
!apps/ml-backend/assets_2/**/

# Whitelist: Documentation Dependencies (Used in ML_Pipeline.md)
!apps/ml-backend/assets_1/eda/correlation_matrix.png
!apps/ml-backend/assets_2/eda/correlation_matrix.png
!apps/ml-backend/assets_2/eval/model_performance_comparison.png
!apps/ml-backend/assets_2/eval/f1_optimization.png
!apps/ml-backend/assets_2/eval/Logistic_Regression_cm_0.35.png

# Whitelist: Production Models (Primary Dataset Architecture)
!apps/ml-backend/assets_2/models/
!apps/ml-backend/assets_2/models/*.pkl

# Ensure .gitkeep files are never ignored
!**/.gitkeep

# Virtual Environments
venv/
env/
.venv/

# IDE specific files
.vscode/
.idea/
.ipynb_checkpoints/

# OS specific files
.DS_Store
Thumbs.db

# Dependencies
node_modules/
.pnp
.pnp.*

# Testing
coverage/

# Next.js
.next/
out/
build/

# Misc
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
.env*
.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Documentation & Notebooks
apps/ml-backend/notebooks_1/Project.ipynb

# Temporary Scratch Scripts
apps/ml-backend/scratch/
